# Meridian Relationship Desk — .env template
# Copy to .env and fill in the placeholder values.
# Run scripts/lakebase_setup_db.sh --db-name delta_otters to get Lakebase values.

# ── Workspace ───────────────────────────────────────────────────────────
DATABRICKS_HOST=https://fe-sandbox-serverless-sandbox-eileenzhang.cloud.databricks.com
DATABRICKS_WORKSPACE_ID=7474652327007099
DATABRICKS_WAREHOUSE_ID=a8f028d50c2c72c6

# ── App identity ────────────────────────────────────────────────────────
APP_NAME=delta-otter-meridian-bank

# ── Demo data ───────────────────────────────────────────────────────────
DEMO_CATALOG=techsummit2026
DEMO_SCHEMA=delta-otters

# ── Lakebase (run scripts/lakebase_setup_db.sh --db-name delta_otters) ──
LAKEBASE_PROJECT_ID=delta-otter-meridian-bank
LAKEBASE_ENDPOINT=projects/delta-otter-meridian-bank/branches/production/endpoints/primary
PGHOST=ep-raspy-bird-d7oxkz6g.database.eu-central-1.cloud.databricks.com
PGDATABASE=delta_otters

# ── Agent data backend (pick ONE or both) ───────────────────────────────
# MAS endpoint — leave empty if using Genie only:
MAS_ENDPOINT_NAME=
# Genie space — the Meridian Customer 360 space:
GENIE_SPACE_ID=01f1a1fe534a1bb0b690342ab7752ce8

# ── Optional resource IDs (deep-links on /platform page) ────────────────
DASHBOARD_ID=01f1a1fb058d19e48a2c66d9493db433
PIPELINE_ID=
AGENT_MLFLOW_EXPERIMENT_PATH=
KA_ENDPOINT_NAME=
